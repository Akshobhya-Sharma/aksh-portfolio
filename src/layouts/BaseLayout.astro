---
import "../styles/fonts.css";
import "../styles/tokens.css";
import "../styles/main.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Aksh | UX portfolio",
  description = "Aksh is a tech generalist working in UX design, accessibility and front-end development.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Critical weights only: heading light + body regular -->
    <link
      rel="preload"
      href="/fonts/newsreader-latin-300-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/figtree-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">
      Skip to main content
    </a>
    <slot name="header" />
    <main id="main">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>
