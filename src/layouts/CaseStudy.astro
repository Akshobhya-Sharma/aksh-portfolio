---
import { getImage } from "astro:assets";
import type { ImageMetadata, MarkdownHeading } from "astro";
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/prose.css";
import SideNav from "../components/case-study/SideNav.astro";

interface Props {
  title: string;
  summary: string;
  width: "default" | "wide";
  accent: string;
  cover?: { src: ImageMetadata; alt: string };
  headings: MarkdownHeading[];
}

const { title, summary, width, accent, cover, headings } = Astro.props;

// The cover is the only eager image, so it drives page weight. <Picture> takes one quality for all
// formats; AVIF at 75 is smaller than WebP at 90 and measured closer to the source (PSNR) on both covers.
const coverWidths = [640, 960, 1280];
const coverSizes = "(min-width: 1440px) 90rem, 100vw";
const [coverAvif, coverWebp] = cover
  ? await Promise.all([
      getImage({ src: cover.src, format: "avif", quality: 75, widths: coverWidths }),
      getImage({ src: cover.src, format: "webp", quality: 90, widths: coverWidths }),
    ])
  : [];
---

<BaseLayout title={`${title} | Aksh`} description={summary}>
  <Header slot="header" />
  <article
    class={`shell case-study case-study--${width}`}
    style={`--case-accent: var(--${accent})`}
  >
    <header class="case-study__intro">
      <h1>{title}</h1>
      <p class="case-study__summary">{summary}</p>
      {cover && coverAvif && coverWebp && (
        <picture>
          <source type="image/avif" srcset={coverAvif.srcSet.attribute} sizes={coverSizes} />
          <img
            class="case-study__cover"
            src={coverWebp.src}
            srcset={coverWebp.srcSet.attribute}
            sizes={coverSizes}
            width={coverWebp.attributes.width}
            height={coverWebp.attributes.height}
            alt={cover.alt}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      )}
    </header>
    <div class="case-study__body">
      <SideNav headings={headings} />
      <div class="case-study__content prose">
        <slot />
      </div>
    </div>
  </article>
  <Footer slot="footer" />
</BaseLayout>

<style>
  .case-study {
    padding-block: var(--section-padding-block);
    border-bottom: 1px solid var(--color-neutral-200);
  }
  .case-study__intro {
    padding-block-start: var(--space-24);
    border-block-start: var(--space-8) solid var(--case-accent); /* decoration only */
    margin-block-end: var(--space-48);
  }
  .case-study--wide .case-study__intro {
    max-width: none;
  }
  .case-study__summary {
    margin: var(--space-16) 0 0;
    font-size: var(--text-body-1);
  }
  .case-study__cover {
    margin-block-start: var(--space-32);
    width: 100%;
    height: auto;
  }
  .case-study__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-32);
  }
  .case-study__content {
    min-width: 0;
    max-width: 70ch;
    overflow-wrap: anywhere;
  }
  .case-study--wide .case-study__content {
    max-width: 100ch;
  }
  .case-study__content > :global(* + *) {
    margin-block-start: var(--space-16);
  }
  .case-study__content > :global(:is(h2, h3, h4)) {
    margin-block-start: var(--space-40);
    scroll-margin-top: var(--sticky-offset);
  }
  /* Figure, ImageGrid and ZoomCanvas render a figure; give it more room under a heading */
  .case-study__content > :global(:is(h2, h3, h4) + figure) {
    margin-block-start: var(--space-24);
  }
  .case-study__content :global(p),
  .case-study__content :global(li) {
    font-size: var(--text-body-1);
  }
  @media (min-width: 1024px) {
    .case-study__body {
      grid-template-columns: minmax(12rem, 16rem) minmax(0, 1fr);
      gap: var(--gap);
      align-items: start;
    }
  }
</style>
