---
import type { Category } from "../data/home";

interface Props {
  category: Category;
}
const { category } = Astro.props;
const style = `--core: var(--${category.gradient}-core); --edge: var(--${category.gradient}-edge)`;
---

<h3 class="tile" style={style}>
  {category.title}
</h3>

<style>
  /* No overflow:hidden or filters: nothing clips, and the noise is a plain background layer under the text. */
  .tile {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    margin: 0;
    padding: var(--space-24);
    border-radius: var(--space-8);
    color: var(--color-white);
    text-align: center;
    overflow-wrap: anywhere;
    background:
      var(--noise-image), radial-gradient(circle at 50% 40%, var(--core), var(--edge) 85%);
  }
</style>
