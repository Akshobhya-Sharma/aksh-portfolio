---
// Shared image pipeline for Figure, ImageGrid and ZoomCanvas, so none of them can drift into a blurry variant.
// Sharp's default AVIF quality is 50, which smears text in screenshots; quality 90 keeps it crisp.
import { Image, Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  eager?: boolean;
  widths?: number[]; // capped to the source width by Astro
  sizes?: string;
}
const {
  src,
  alt,
  eager = false,
  widths = [640, 960, 1280, 1920],
  sizes = "(min-width: 1024px) 60rem, 100vw",
} = Astro.props;
const isSvg = src.format === "svg"; // vector: passed through, no AVIF/WebP
const loading = eager ? "eager" : "lazy";
const fetchpriority = eager ? "high" : undefined;
---

{isSvg ? (
  <Image
    src={src}
    alt={alt}
    format="svg"
    loading={loading}
    decoding="async"
    fetchpriority={fetchpriority}
  />
) : (
  <Picture
    src={src}
    alt={alt}
    formats={["avif", "webp"]}
    quality={90}
    widths={widths}
    sizes={sizes}
    loading={loading}
    decoding="async"
    fetchpriority={fetchpriority}
  />
)}
