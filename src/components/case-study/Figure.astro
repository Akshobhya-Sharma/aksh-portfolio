---
import type { ImageMetadata } from "astro";
import CaseImage from "./CaseImage.astro";

interface Props {
  src: ImageMetadata;
  alt: string; // empty only with `decorative`
  decorative?: boolean;
  caption?: string;
  eager?: boolean;
}
const { src, alt, decorative = false, caption, eager = false } = Astro.props;
if (alt === "" && !decorative) throw new Error("Figure: alt is required unless decorative");
---

<figure class="figure">
  <CaseImage src={src} alt={alt} eager={eager} />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .figure {
    margin: 0;
  }
  .figure :global(img) {
    max-width: 100%;
    height: auto;
  }
  figcaption {
    margin-block-start: var(--space-8);
    font-size: var(--text-body-2);
    color: var(--color-neutral-600);
  }
</style>
