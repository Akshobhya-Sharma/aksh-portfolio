---
import type { ImageMetadata } from "astro";
import CaseImage from "./CaseImage.astro";

interface Props {
  id: string; // unique per page: names the radio group and its ids
  src: ImageMetadata;
  alt: string;
  caption?: string;
  height?: string; // frame height, any CSS length (rem, dvh)
}
const { id, src, alt, caption, height = "24rem" } = Astro.props;
if (!id || /s/.test(id))
  throw new Error("ZoomCanvas: id must be a unique, non-empty id without spaces");
const levels = [
  { value: "fit", label: "Fit" },
  { value: "2x", label: "2x" },
  { value: "3x", label: "3x" },
];
const hintId = `${id}-hint`;
---

<figure class="zoom" style={`--zoom-height: ${height}`}>
  <fieldset class="zoom__levels">
    <legend>Zoom</legend>
    {levels.map((level) => (
      <div class="zoom__option">
        <input
          type="radio"
          name={`${id}-zoom`}
          id={`${id}-${level.value}`}
          value={level.value}
          checked={level.value === "fit"}
        />
        <label for={`${id}-${level.value}`}>{level.label}</label>
      </div>
    ))}
  </fieldset>
  <p class="zoom__hint" id={hintId}>
    Pick a zoom level, then scroll or use the arrow keys to move around the image.
  </p>
  {/* eslint-disable astro/jsx-a11y/no-noninteractive-tabindex */}
  <div
    class="zoom__canvas"
    role="region"
    tabindex="0"
    aria-label={`${alt}, scrollable`}
    aria-describedby={hintId}
  >
    <CaseImage src={src} alt={alt} widths={[960, 1920, 2880]} sizes="300vw" />
  </div>
  {/* eslint-enable astro/jsx-a11y/no-noninteractive-tabindex */}
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .zoom {
    margin: 0;
    min-width: 0;
  }
  .zoom__levels {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
    margin: 0 0 var(--space-4);
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .zoom__levels legend {
    padding: 0;
    margin-block-end: var(--space-8);
    font-weight: var(--weight-medium);
  }
  .zoom__option {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    min-height: var(--target-size);
    padding-inline: var(--space-12);
    border: 1px solid var(--color-neutral-400);
  }
  .zoom__option input {
    width: 1.5rem;
    height: 1.5rem;
    margin: 0;
  }
  .zoom__option label {
    display: flex;
    align-items: center;
    min-height: var(--target-size);
  }
  .zoom__option input:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
  /* margin:auto on the image centres it while it fits, and keeps the left/top reachable once it overflows */
  .zoom__canvas {
    display: flex;
    height: var(--zoom-height);
    overflow: auto;
    border: 1px solid var(--color-neutral-400);
    background: var(--color-light);
  }
  /* Raster sources render <picture>; let the img be the flex item in both cases */
  .zoom__canvas :global(picture) {
    display: contents;
  }
  .zoom__canvas :global(img) {
    flex: none;
    margin: auto;
    width: 100%;
    height: auto;
    max-height: 100%;
    object-fit: contain;
  }
  .zoom:has(input[value="2x"]:checked) .zoom__canvas :global(img) {
    width: 200%;
    max-width: none; /* overrides the global img max-width: 100% */
    max-height: none;
  }
  .zoom:has(input[value="3x"]:checked) .zoom__canvas :global(img) {
    width: 300%;
    max-width: none;
    max-height: none;
  }
  /* Without :has the zoom state cannot change, so hide the controls and hint; the image stays at Fit and still scrolls */
  @supports not selector(:has(*)) {
    .zoom__levels,
    .zoom__hint {
      display: none;
    }
  }
  /* .zoom prefix: outranks the case-study rule that sets p to body-1 */
  .zoom .zoom__hint {
    margin-block: 0 var(--space-8);
    font-size: var(--text-body-2);
    color: var(--color-neutral-600);
  }
  figcaption {
    margin-block: var(--space-8) 0;
    font-size: var(--text-body-2);
    color: var(--color-neutral-600);
  }
</style>
