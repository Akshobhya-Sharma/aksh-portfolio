---
import { hero } from '../data/home';
---

<section class="section hero" aria-labelledby="hero-heading">
	<div class="shell">
		<h1 id="hero-heading">
			{hero.before}<span class="accent">{hero.accentWord}</span>{hero.after}
		</h1>
		<p class="hero__intro">{hero.intro}</p>
		<a class="hero__cta" href={hero.cta.href}>
			{hero.cta.label}
			<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
				<path d="M8 2v10M3 8l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" />
			</svg>
		</a>
	</div>
</section>

<style define:vars={{ 'hero-accent': `var(--${hero.accent})` }}>
	.hero h1 {
		max-width: 20ch;
	}
	.accent {
		font-style: italic;
		color: var(--hero-accent);
	}
	.hero__intro {
		max-width: 60ch;
		margin-block: var(--space-24) var(--space-32);
		font-size: var(--text-body-1);
	}
	.hero__cta {
		display: inline-flex;
		align-items: center;
		gap: var(--space-8);
		min-height: var(--target-size);
		padding-inline: var(--space-24);
		background: var(--color-dark);
		color: var(--color-light);
		font-size: var(--text-button);
		font-weight: var(--weight-medium);
		text-decoration: none;
	}
	.hero__cta:hover {
		background: var(--color-neutral-700);
	}
	@media (forced-colors: active) {
		.hero__cta {
			border: 1px solid LinkText;
		}
	}
</style>
