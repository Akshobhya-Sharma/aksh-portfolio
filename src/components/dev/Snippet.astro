---
// Dev-only: shows registry code, escaped by Astro, one block per line so a triple-click selects a single line.
// Without `variant` it shows the component's import line; with one, that variant's usage code.
import { components } from "../../data/components";

interface Props {
  component: string;
  variant?: string;
}
const { component, variant } = Astro.props;
const entry = components.find((c) => c.id === component);
const v = variant === undefined ? undefined : entry?.variants.find((x) => x.name === variant);
if (!entry || (variant !== undefined && !v))
  throw new Error(`Snippet: unknown ${component}/${variant}`);
const kind = v ? "Usage" : "Import";
const lines = (v ? v.snippet : entry.importLine).split("\n");
const labelId = `${component}-${variant ?? "import"}`.replace(/\s+/g, "-") + "-code";
---

<p class="snippet__label" id={labelId}>
  {v ? `Usage: ${variant}` : "Import"}
</p>
{/* eslint-disable astro/jsx-a11y/no-noninteractive-tabindex */}
<pre
  class="snippet"
  tabindex="0"
  role="region"
  aria-label={`${kind} code, scrollable`}
  aria-describedby={labelId}
><code>{lines.map((line) => <span class="line">{line}</span>)}</code></pre>
{/* eslint-enable astro/jsx-a11y/no-noninteractive-tabindex */}

<style>
  .snippet__label {
    margin: var(--space-16) 0 var(--space-4);
    font-weight: var(--weight-medium);
  }
  .snippet {
    margin: 0 0 var(--space-16);
    padding: var(--space-16);
    max-width: 100%;
    overflow-x: auto;
    border: 1px solid var(--color-neutral-400);
    background: var(--color-light);
    color: var(--color-dark);
    font-family: var(--font-mono);
    font-size: var(--text-body-2);
    line-height: var(--leading-body);
  }
  /* One block per line; an empty line keeps its height */
  .line {
    display: block;
    min-height: calc(var(--leading-body) * 1em);
  }
</style>
